# Public college timetable. Override this if the sheet moves.
SPREADSHEET_ID=1EfkP6uXq7hjjehptSWfz3Q_duqAqfyOkNdpH23B2ctE
SPREADSHEET_TITLE=BTech Cohort Planning weekly | 2025-29 - 12th Oct to 17th Oct 2026

COLLEGE_NAME=ITM Skills University
SCHOOL_NAME=School of FutureTech, Kharghar
COURSE_NAME=BTech

# Asia/Kolkata keeps "today" aligned with the Kharghar campus.
TIMEZONE=Asia/Kolkata
# The sheet writes dates as DD/MM/YYYY.
DATE_ORDER=DMY

PORT=8787
# How often the server re-reads the sheet. 45 seconds is within the requested 30–60s range.
SYNC_INTERVAL_SECONDS=45
# Inferred edits stay highlighted for this long, then return to the normal style.
# Explicit OFF / CANCELLED stays red until the sheet itself changes.
HIGHLIGHT_HOURS=72

DATABASE_PATH=./data/timetable.sqlite

# Set by the Vercel Blob store. Keeps the timetable and its change log across
# cold starts, so a lecture removed from the sheet stays on the grid as cancelled.
# BLOB_READ_WRITE_TOKEN=

# Set this if the Vite app is hosted separately and calls the API on another origin.
# CLIENT_ORIGIN=https://timetable.example.com
# VITE_API_URL=https://api.example.com
